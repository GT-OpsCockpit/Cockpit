# HTTPS certificate is requested and renewed automatically for {$DOMAIN}.
{$DOMAIN} {
	encode gzip

	# /api/* -> the API, path unchanged (the API itself serves everything under /api).
	# flush_interval -1 keeps the live-updates stream (/events) flowing.
	handle /api/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# Everything else is the web app.
	handle {
		reverse_proxy web:80
	}
}
