# Copy to deploy/.env on the SERVER (cp .env.example .env) and fill it in.
# This file is never committed (.env is gitignored) — it holds secrets.

# Public address of Cockpit (DNS A record pointing at the server's IP)
DOMAIN=cockpit.gt-ops.club

# Database / file storage — choose long random passwords (e.g. `openssl rand -hex 24`)
POSTGRES_USER=cockpit
POSTGRES_DB=cockpit
POSTGRES_PASSWORD=
MINIO_ROOT_USER=cockpit-minio
MINIO_ROOT_PASSWORD=
S3_BUCKET=cockpit-uploads

# First administrator, created by the seed (the login code is emailed to ADMIN_EMAIL)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Outgoing email — required: logins use a code sent by email, and partners get
# their booking emails from here. Same values as in your local apps/api/.env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PARTNER_MAILER_FROM=contact@gt-ops.club

# Secret that signs the Confirm/Decline links sent to partners (`openssl rand -hex 32`).
# Never change it once partners have received links, or those links stop working.
PARTNER_LINK_SECRET=

# WhatsApp (Twilio). Leave empty to keep messages in the logs only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional: where the nightly backup sends a failure alert
BACKUP_ALERT_EMAIL=
