POSTGRES_USER=cockpit
POSTGRES_PASSWORD=cockpit
POSTGRES_DB=cockpit

# MinIO (S3-compatible object storage for uploaded files). The api service
# reuses this root account directly as its S3 credentials.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=cockpit-uploads
S3_REGION=us-east-1

# Docker Hub namespace images are pushed to / pulled from (see .github/workflows)
DOCKERHUB_NAMESPACE=gtopscockpit
# Tag to deploy on the VPS; GitHub Actions overrides this to the commit SHA on deploy
IMAGE_TAG=latest
