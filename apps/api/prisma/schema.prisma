// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DISPATCHER
}

enum ClientType {
  INDIVIDUAL
  COMPANY
  EVENT
}

enum Billing {
  ACCOUNT
  CASH
  CARD
}

enum Service {
  TSF
  ASD
  SPEC
}

enum TripStepKind {
  TRANSMITTED
  RECEIVED
  ACCEPTED
  ENROUTE
  ARRIVED
  ONBOARD
  DROPPED
}

enum CancellationFee {
  FREE
  FIFTY
  SEVENTYFIVE
  HUNDRED
}

enum DriverUnavailKind {
  OFF
  HOLIDAYS
  SICK
}

enum FleetUnavailKind {
  REPAIR
  SERVICE
  BODYWORK
}

model User {
  id            String    @id @default(cuid())
  // O-001, O-002... for an Admin, D-001, D-002... for a Dispatcher: two
  // independent series, assigned from the role held at creation and never
  // rewritten afterwards, same convention as driver and fleet refs
  // (server.js:788-806).
  ref           String    @unique
  email         String    @unique
  passwordHash  String
  role          Role
  firstName     String
  lastName      String
  phone         String?
  active        Boolean   @default(true)
  deactivatedAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  sessions      Session[]
  otpCodes      OtpCode[]
}

model Session {
  id        String   @id @default(cuid()) // = token en cookie httpOnly
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Country {
  code            String  @id // ex: "FR", "US-NY"
  name            String
  dialCode        String?
  currency        String?
  defaultTimezone String
}

model Client {
  id               String    @id @default(cuid())
  ref              String    @unique // CI/CC/CE{n}
  clientType       ClientType
  contactFirstName String?
  contactLastName  String?
  company          String?
  acronym          String?
  refPoOther       String?
  address          String?
  postalCode       String?
  city             String?
  countryCode      String?
  vatNumber        String?
  email            String?   // normalized (trimmed+lowercased) by ClientsService before write; NOT unique — one client can have an account per country/entity sharing an address
  billing          Billing?
  pocName          String?
  pocPhone         String?
  pocEmail         String?
  eventCountry     String?
  eventArea        String?
  eventStartDate   DateTime?
  eventEndDate     DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  trips            Trip[]
  invoices         Invoice[]
  drivers          Driver[]       @relation("EventDrivers")
  fleetVehicles    FleetVehicle[] @relation("EventFleetVehicles")
  contacts         ClientContact[]
  passengers       Passenger[]
  priceLists       PriceList[]    @relation("ClientPriceLists")
}

/** One of a client's points of contact (POC) -- "POC 1, POC 2..." in the UI, ordered by `order`. */
model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id             String                @id @default(cuid())
  ref            String                @unique // D-{scope}-{n}
  countryCode    String?
  firstName      String?
  lastName       String?
  phone          String?               @unique
  email          String?
  area           String                @default("Local")
  eventsOnly     Boolean               @default(false)
  eventCountry   String? // driver's own base country/area for event linking, distinct from the linked event Client's
  eventArea      String?
  eventClientId  String?
  eventClient    Client?               @relation("EventDrivers", fields: [eventClientId], references: [id])
  // Free-text partner tag — kept for now (ref-prefix generation, search, the
  // create/update DTOs all still read it) alongside the new, structured
  // `partnerId` below. A driver attached to a real Partner from the Drivers &
  // Partners page gets both: `company` continues to drive the existing
  // ref-prefix/search behaviour unchanged, `partnerId` is what the new
  // Partner CRUD, roster and email-notification features read. Once every
  // partner driver has a `partnerId` (after the migration + a follow-up
  // cleanup pass), `company` can be retired.
  company        String?
  // Set only for a partner's own driver (attached from their roster on the
  // Drivers & Partners page); null for an in-house/local driver.
  partnerId      String?
  partner        Partner?              @relation(fields: [partnerId], references: [id])
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  unavailability DriverUnavailability?
  trips          Trip[]                @relation("AssignedDriver")
  partnerTrips   Trip[]                @relation("PartnerDriver")
  fleetReserved  FleetVehicle?         @relation("ReservedForDriver")
}

/**
 * A sub-contracted partner — a company with its own roster of drivers and
 * vehicles, or a lone individual (`individual: true`, no company name).
 * New, structured companion to the free-text `company`/`partnerCompany`
 * convention on Driver/FleetVehicle: real contact info (so a job can be
 * emailed to the partner automatically) and a real link between a partner's
 * own drivers and vehicles, which the old text fields never had.
 */
model Partner {
  id            String         @id @default(cuid())
  ref           String         @unique // P-{n}
  individual    Boolean        @default(false)
  companyName   String? // null when individual — see NewPartner mockup
  contactName   String // "Manager/dispatch name", or "Contact name" when individual
  phone         String
  // Second contact number, alongside phone — optional (a partner with only
  // a landline still has a contact number, this is a convenience second one).
  mobile        String?
  email         String
  countryCode   String?
  area          String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  drivers       Driver[]
  fleetVehicles FleetVehicle[]
  directTrips   Trip[]         @relation("DirectPartner")
}

model DriverUnavailability {
  id        String            @id @default(cuid())
  driverId  String            @unique
  driver    Driver            @relation(fields: [driverId], references: [id])
  type      DriverUnavailKind
  date      DateTime? // type = OFF
  startDate DateTime? // type = HOLIDAYS | SICK
  endDate   DateTime?
}

model VehicleType {
  id               String           @id @default(cuid())
  ref              String           @unique // V{n}
  name             String           @unique
  maxPax           Int
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  fleetVehicles    FleetVehicle[]
  trips            Trip[]
  passengerRoutes  PassengerRoute[]
  priceListEntries PriceListEntry[]
}

model Passenger {
  id        String             @id @default(cuid())
  ref       String             @unique // PSG{n}
  firstName String?
  lastName  String?
  phone     String?
  email     String?
  notes     String?
  clientId  String?
  client    Client?            @relation(fields: [clientId], references: [id])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  routes    PassengerRoute[]
  addresses PassengerAddress[]
}

model PassengerAddress {
  id          String    @id @default(cuid())
  passengerId String
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  title       String
  address     String
  info        String?
  countryCode String?
  postalCode  String?
  area        String?
  isAirport   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PassengerRoute {
  id              String       @id @default(cuid())
  passengerId     String
  passenger       Passenger    @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  pickupLocation  String
  dropoffLocation String?
  vehicleTypeId   String?
  vehicleType     VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  priceEur        Decimal
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model PriceList {
  id        String           @id @default(cuid())
  ref       String           @unique // PL{n}
  name      String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  entries   PriceListEntry[]
  clients   Client[]         @relation("ClientPriceLists")
}

model PriceListEntry {
  id                 String       @id @default(cuid())
  priceListId        String
  priceList          PriceList    @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  pickupLocation     String?
  pickupPostalCodes  String[]     @default([])
  pickupCountryCode  String?
  dropoffLocation    String?
  dropoffPostalCodes String[]     @default([])
  dropoffCountryCode String?
  bidirectional      Boolean      @default(false)
  vehicleTypeId      String?
  vehicleType        VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  priceEur           Decimal
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model FleetVehicle {
  id             String                @id @default(cuid())
  ref            String                @unique // F{n}
  categoryId     String
  category       VehicleType           @relation(fields: [categoryId], references: [id])
  regNbr         String                @unique
  make           String
  model          String
  yearOfBuild    Int
  fourWD         Boolean
  nbPax          Int
  color          String                @default("Metallic Black")
  acronym        String? // max 6 chars, validé en DTO
  isLocal        Boolean               @default(true)
  countryCode    String?
  area           String?
  // Kept for now alongside `partnerId` below — see Driver.company's comment.
  partnerCompany String?
  // Set only for a partner's own vehicle; null for an in-house/local one.
  partnerId      String?
  partner        Partner?              @relation(fields: [partnerId], references: [id])
  driverId       String?               @unique
  driver         Driver?               @relation("ReservedForDriver", fields: [driverId], references: [id])
  eventsOnly     Boolean               @default(false)
  eventCountry   String? // vehicle's own base country/area for event linking, distinct from the linked event Client's
  eventArea      String?
  eventClientId  String?
  eventClient    Client?               @relation("EventFleetVehicles", fields: [eventClientId], references: [id])
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  unavailability FleetUnavailability?
  trips          Trip[]
}

model FleetUnavailability {
  id             String           @id @default(cuid())
  fleetVehicleId String           @unique
  fleetVehicle   FleetVehicle     @relation(fields: [fleetVehicleId], references: [id])
  type           FleetUnavailKind
  startDate      DateTime
  endDate        DateTime
}

model Trip {
  id                    String           @id @default(cuid())
  ref                   String           @unique // R-{clientRef}-{YY}-{seq}
  countryCode           String?
  area                  String?
  timezone              String?
  pickupAt              DateTime
  pickupLocation        String
  dropoffLocation       String?
  service               Service
  hours                 Int?
  instructions          String?
  clientId              String
  client                Client           @relation(fields: [clientId], references: [id])
  passengerName         String
  pocName               String?
  pocPhone              String?
  pocEmail              String?
  tracking              Boolean          @default(true)
  paxCount              Int?
  vehicleTypeId         String?
  vehicleType           VehicleType?     @relation(fields: [vehicleTypeId], references: [id])
  fleetVehicleId        String?
  fleetVehicle          FleetVehicle?    @relation(fields: [fleetVehicleId], references: [id])
  priceEur              Decimal?
  partnerRateEur        Decimal?
  driverId              String?
  driver                Driver?          @relation("AssignedDriver", fields: [driverId], references: [id])
  billing               Billing?
  flightNumber          String?
  bufferTime            Int?
  fboAddress            String?
  tailNbr               String?
  /// Name to write on the pickup sign (legacy `nameboard`) — distinct from
  /// nameboardUrl below, which is the optional attached file (a logo, or a
  /// photo of the board itself).
  nameboard             String?
  nameboardUrl          String? // fichier stocké (volume Docker), plus de base64 en mémoire
  pickupIata            String?
  dropoffIata           String?
  trainNumber           String?
  trainObservation      String?
  subContractor         Boolean          @default(false)
  // Unchanged: still points at the Driver record standing in for the
  // sub-contracted partner (see Driver.company/partnerId). The email that
  // goes to the *partner company itself* (as opposed to this specific
  // partner driver) is resolved from `partner.partner` — i.e. whichever
  // real Partner this Driver is attached to — see resolvePartnerEmail.
  partnerId             String?
  partner               Driver?          @relation("PartnerDriver", fields: [partnerId], references: [id])
  // Set when this booking is farmed out straight to a Partner *company*,
  // with no specific driver of theirs picked yet (the "partenaire sans
  // driver" case) — mutually exclusive with partnerId above, which points at
  // one of that company's own Driver records instead. Dispatching one of
  // these has no WhatsApp leg (there is no driver to message): the partner's
  // own email is sent automatically as soon as the booking is saved against
  // them, since there is no separate "Dispatch" click for a company with
  // nobody named on file (see decideAssignment's `locked`).
  directPartnerId       String?
  directPartner         Partner?         @relation("DirectPartner", fields: [directPartnerId], references: [id])
  dispatched            Boolean          @default(false)
  invoiced              Boolean          @default(false)
  assignmentCancelled   Boolean          @default(false)
  assignmentCancelledAt DateTime?
  // Set when the sub-contracted partner declined the booking from their email
  // (the Decline button); cleared as soon as it is reassigned, edited or confirmed.
  partnerDeclinedAt     DateTime?
  // Who declined (their Driver or Partner ref): the partner is taken off the booking
  // when they decline, but their old email links must keep resolving to them.
  partnerDeclinedRef    String?
  // The vehicle that was on the booking then (also taken off), kept only so the
  // signed links of that email still verify.
  partnerDeclinedRegNbr String?
  // The booking was edited after being sent to its sub-contracted partner: the
  // status reads "Updated - Send ?" until the updated email goes out.
  partnerUpdatePending  Boolean          @default(false)
  cancellationFee       CancellationFee?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  steps                 TripStep[]
  invoiceLinks          InvoiceTrip[]
}

model TripStep {
  id         String       @id @default(cuid())
  tripId     String
  trip       Trip         @relation(fields: [tripId], references: [id])
  step       TripStepKind
  occurredAt DateTime     @default(now())

  @@unique([tripId, step])
}

model Invoice {
  id          String        @id @default(cuid())
  ref         String        @unique // INV{n}
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  isEvent     Boolean       @default(false)
  refPo       String?
  periodStart DateTime?
  periodEnd   DateTime?
  totalHT     Decimal
  vatRate     Decimal       @default(0.10)
  totalTTC    Decimal
  createdAt   DateTime      @default(now())
  trips       InvoiceTrip[]
}

model InvoiceTrip {
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id])

  @@id([invoiceId, tripId])
}

model CompanyInfo {
  id           Int      @id @default(1)
  name         String?
  legalName    String?
  street1      String?
  zipCode      String?
  city         String?
  countryCode  String?
  vatNbr       String?
  email        String?
  website      String?
  ownerSurname String?
  ownerName    String?
  mobile       String?
  ownerEmail   String?
  saved        Boolean  @default(false)
}

model FxRateCache {
  currency   String   @id
  eurPerUnit Decimal
  fetchedAt  DateTime
}

/**
 * Freed {clientRef}-{YY}-{seq} trip-ref slots, reused (smallest first) before
 * RefCounter mints a new sequence number — mirrors the legacy's
 * releasedBookingSeqs Map (see generateBookingRef/releaseBookingRef).
 */
model ReleasedTripSeq {
  key String // "{clientRef}:{YY}"
  seq Int

  @@id([key, seq])
}

model RefCounter {
  scope     String @id // ex: "trip:C00001:26", "invoice", "client:individual"
  lastValue Int    @default(0)
}
