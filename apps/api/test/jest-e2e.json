{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "packages/shared/.*\\.js$": "<rootDir>/jest-esm-js-transformer.cjs",
    "packages/shared/.*\\.(t|j)s$": ["ts-jest", { "isolatedModules": true }],
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@cockpit/shared$": "<rootDir>/../../packages/shared/src/index.ts"
  }
}
